APP_NAME="CCS Portal"
APP_ENV=production
APP_KEY=                      # generated in Part 4, step 3
APP_DEBUG=false               # NEVER true in production
APP_URL=https://portal.yourschool.edu
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ccs_portal
DB_USERNAME=ccs_user          # a dedicated user, never root
DB_PASSWORD=use-a-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # cookies only over HTTPS
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourschool.edu"
MAIL_FROM_NAME="${APP_NAME}"